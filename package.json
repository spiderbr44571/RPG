{
  "name": "mastermind-rpg-desktop",
  "private": true,
  "version": "1.0.2",
  "scripts": {
    "test": "python3 tests/runtime/prepare.py && playwright test",
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test:desktop": "node --test desktop/tests/*.test.cjs",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64 --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^43.8.4",
    "electron-builder": "^25.1.8"
  },
  "productName": "Mastermind",
  "description": "Mastermind RPG Linux desktop — mestragem LAN, canvas and Godot fixes",
  "main": "desktop/main.cjs",
  "license": "UNLICENSED",
  "build": {
    "appId": "dev.rpgmesa.mastermind",
    "productName": "Mastermind",
    "asar": true,
    "files": [
      "desktop/**/*",
      "app/src/main/assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "executableName": "mastermind",
      "artifactName": "Mastermind-v${version}-Linux-${arch}.${ext}"
    }
  }
}
