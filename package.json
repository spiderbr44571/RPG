{
  "name": "mastermind-rpg-desktop",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "test": "python3 tests/runtime/prepare.py && playwright test",
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test:desktop": "node --test desktop/tests/*.test.cjs",
    "dist:linux": "npm run build:server && electron-builder --linux AppImage tar.gz --x64 --publish never",
    "build:server": "bash desktop/server/build.sh",
    "test:campaign": "node --test desktop/tests/campaign.test.cjs",
    "dist:windows": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "productName": "Mastermind",
  "description": "Mastermind RPG — Windows e Linux desktop",
  "main": "desktop/main.cjs",
  "license": "UNLICENSED",
  "build": {
    "appId": "dev.rpgmesa.mastermind",
    "productName": "Mastermind",
    "asar": true,
    "files": [
      "desktop/**/*",
      "app/src/main/assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "executableName": "mastermind",
      "artifactName": "Mastermind-v${version}-Linux-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "desktop/server/dist/mastermind-campaign-server.jar",
        "to": "server/mastermind-campaign-server.jar"
      },
      {
        "from": "app/src/main/assets",
        "to": "server/assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/mastermind.ico",
      "artifactName": "Mastermind-v${version}-Windows-${arch}-${target}.${ext}",
      "extraResources": [
        {
          "from": "desktop/runtime/windows",
          "to": "runtime/windows",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Mastermind"
    }
  }
}
